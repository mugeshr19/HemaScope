# Environment Variables — copy to .env and fill in values

# LLM
LLM_PROVIDER=openai                    # gemini | openai | ollama
OPENAI_API_KEY=sk-your-key-here
LLM_BASE_URL=                          # leave empty for OpenAI; set http://localhost:11434/v1 for Ollama
LLM_MODEL=gpt-4o-mini                  # or llama3, llama-3.3-70b-versatile, gemini-2.0-flash

# Gemini (only needed if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/blood_cell_db

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Model
MODEL_WEIGHTS=weights/best.pt
PRETRAINED_WEIGHTS=yolo11n.pt
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
IMAGE_SIZE=640

# Training
EPOCHS=100
DEVICE=0
PATIENCE=20
WORKERS=8

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
